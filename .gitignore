# Godot cache and generated files (rebuilt automatically when you open the project)
.godot/
/android/
# Web/desktop export output
/export/
*.tmp

# Screenshots made by the helper tools
/tools/shots/

# Output of tools/run_all.gd (A7)
/tools/test_logs/

# Files the Claude desktop app saves into the project
/Claude outputs/

# Raw asset downloads (processed copies go to assets/)
/assets_source/

# Release builds (zips to upload to itch.io) – rebuilt from a git tag when needed
/releases/
