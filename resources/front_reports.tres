[ext_resource type="Script" path="res://scripts/game/front_reports.gd" id="1_1nw3b"]

[resource]
script = ExtResource("1_1nw3b")
dates = PackedStringArray("21.12.1939", "22.12.1939", "23.12.1939", "24.12.1939", "25.12.1939", "26.12.1939", "27.12.1939", "28.12.1939", "31.12.1939", "01.01.1940")
texts = PackedStringArray("\"Täällä Kannaksen rintama. Summan suunnalla on havaittu vihollisen tiedustelu- ja jalkaväkiosastoja. Etumaastossa on käyty päivän aikana tulitaisteluita. Puolustusasemamme ovat säilyneet lujina.\"", "\"Täällä Kannaksen rintama. Summan lohkolla vihollinen on lisännyt hyökkäystoimintaansa ja tuonut uusia joukkoja etulinjaan. Useat etenemisyritykset on torjuttu. Joukkojen mieliala on hyvä.\"", "\"Rintamatiedotus Kannakselta. Summan suunnalla vihollinen on tukenut hyökkäyksiään voimakkaalla konekivääritulella. Kovista hyökkäyksistä huolimatta asemamme ovat edelleen hallussamme.\"", "\"Täällä Kannaksen rintama. Vihollinen on valmistellut hyökkäyksiään voimakkaalla tykistötulella sekä konekivääriosastojen tukemana. Puolustajat jatkavat tehtävissään asemissaan.\"", "\"Rintamatiedotus Summasta. Vihollinen jatkaa painostusta koko lohkolla. Konekiväärien tukemat hyökkäykset on torjuttu, eikä asemissamme ole tapahtunut muutoksia.\"", "\"Täällä Kannaksen rintama. Vihollisen on havaittu keskittävän uusia joukkoja Summan eteen. Tykistötoiminta on jatkunut vilkkaana. Puolustusvalmisteluja jatketaan kaikilla osastoilla.\"", "\"Rintamatiedotus Summan lohkolta. Vihollinen on lisännyt konekivääriosastojen käyttöä hyökkäystensä tukena. Päivän taistelut ovat päättyneet puolustajiemme onnistuneeseen torjuntaan.\"", "\"Täällä Kannaksen rintama. Vihollinen on pyrkinyt murtamaan puolustusta voimakkaalla tykistötulella ja useilla jalkaväkihyökkäyksillä. Joukkomme pitävät edelleen asemansa.\"", "\"Rintamatiedotus Summasta. Vihollinen jatkaa joukkojensa keskittämistä hyökkäysalueelle. Taistelutoiminta on ollut vilkasta, mutta puolustuslinjamme kestää edelleen.\"", "\"Täällä Kannaksen rintama. Vihollinen on tehostanut hyökkäyksiään Summan lohkolla tykistön ja suurten jalkaväkivoimien tukemana. Kaikista hyökkäyksistä huolimatta asemamme ovat säilyneet hallussamme. Puolustajien taistelutahto on horjumaton.\"")
photos = PackedStringArray("res://assets/photos/sa_kuva_144612.jpg", "res://assets/photos/sa_kuva_117623.jpg", "res://assets/photos/sa_kuva_a_4.jpg", "res://assets/photos/sa_kuva_a_511.jpg", "res://assets/photos/sa_kuva_a_126.jpg", "res://assets/photos/sa_kuva_a_125.jpg", "res://assets/photos/sa_kuva_a_8.jpg", "res://assets/photos/sa_kuva_a_123.jpg", "res://assets/photos/sa_kuva_144607.jpg", "res://assets/photos/sa_kuva_a_129.jpg")
