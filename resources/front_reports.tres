[ext_resource type="Script" path="res://scripts/game/front_reports.gd" id="1_1nw3b"]

[resource]
script = ExtResource("1_1nw3b")
dates = PackedStringArray("21.12.1939", "22.12.1939", "23.12.1939", "24.12.1939", "25.12.1939", "26.12.1939", "27.12.1939", "28.12.1939", "31.12.1939", "01.01.1940")
texts = PackedStringArray("\"Täällä Kannaksen rintama. Vihollinen on päivän aikana jatkanut hyökkäyksiään Summan suunnalla. Puolustusasemamme ovat kestäneet raskaan tykistötulen. Tilanne on hallinnassa.\"", "\"Täällä Kannaksen rintama. Vihollinen on jälleen yrittänyt murtaa asemamme Summan lohkolla. Hyökkäys on torjuttu. Useita vihollispanssareita on tuhottu esteisiin ja korsujen tuleen. Miehistön taistelutahto on hyvä.\"", "\"Rintamatiedotus. Summassa on kulunut päivä ankarissa taisteluissa. Vihollinen jatkaa tykistökeskityksiä, mutta asemamme pitävät. Joukkomme ovat aiheuttaneet hyökkääjälle raskaita tappioita.\"", "\"Jouluaatto Kannaksella. Vihollisen toiminta on ollut vilkasta koko päivän. Puolustajat viettävät pyhää asemissaan. Mieliala joukkojen keskuudessa on luja.\"", "\"Joulupäivä Summassa. Taistelut jatkuvat. Puolustajat viettävät joulua asemissaan. Vihollisen yritykset edetä Viipurin suuntaan on pysäytetty.\"", "\"Kannaksen rintamalta ilmoitetaan vihollisen keskittävän uusia joukkoja etulinjan tuntumaan. Puolustusvalmisteluja jatketaan kaikilla lohkoilla.\"", "\"Tiedotus Summan lohkolta. Päivän aikana suoritetut hyökkäykset on torjuttu. Tykistö ja konekiväärit ovat toimineet tehokkaasti.\"", "\"Vihollinen on yrittänyt hyödyntää pimeyttä tunkeutuakseen etuasemiimme. Yritykset on havaittu ajoissa ja torjuttu.\"", "\"Vuoden viimeinen päivä Kannaksella. Summan puolustajat ovat torjuneet vihollisen hyökkäyksiä jo viikkojen ajan. Asemat pitävät edelleen. Uuteen vuoteen siirrytään valppaina ja taistelutahto korkeana.\"", "\"Täällä Kannaksen rintama. Uusi vuosi on alkanut vihollisen tykistötulella Summan lohkolla. Puolustajat ovat kuitenkin säilyttäneet asemansa. Tilanne rintamalla on vakaa.\"")
photos = PackedStringArray("res://assets/photos/sa_kuva_144612.jpg", "res://assets/photos/sa_kuva_a_511.jpg", "res://assets/photos/sa_kuva_144608.jpg", "res://assets/photos/sa_kuva_a_128.jpg", "res://assets/photos/sa_kuva_a_126.jpg", "res://assets/photos/sa_kuva_a_125.jpg", "res://assets/photos/sa_kuva_a_8.jpg", "res://assets/photos/sa_kuva_a_123.jpg", "res://assets/photos/sa_kuva_144607.jpg", "res://assets/photos/sa_kuva_a_129.jpg")
