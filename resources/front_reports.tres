[gd_resource type="Resource" script_class="FrontReports" format=3]

[ext_resource type="Script" path="res://scripts/game/front_reports.gd" id="1_1nw3b"]

[resource]
script = ExtResource("1_1nw3b")
dates = PackedStringArray("30 November 1939", "17 December 1939", "19 December 1939", "22 December 1939", "1 February 1940", "6 February 1940", "11 February 1940", "12 February 1940", "13 February 1940", "15 February 1940")
texts = PackedStringArray("Soviet forces have crossed the border. All units are ordered to battle stations. Prepare the defenses and repel enemy reconnaissance patrols.", "After hours of artillery fire, Soviet infantry and tanks are advancing against the line. Hold your position at all costs.", "Enemy armor has broken through the obstacles. Finnish defenders must stop the tanks before the breach widens.", "Days of relentless attacks have failed to break the line. One more assault is expected before the enemy withdraws.", "The Soviet artillery barrage has begun. Shells rain down across the front as the enemy prepares a new offensive.", "Enemy attacks continue day and night. Ammunition is running low and casualties are mounting.", "The largest offensive of the war has begun. Hundreds of guns support waves of infantry and tanks. Hold the line.", "Enemy forces have broken into key defensive positions. Delay the advance while neighboring units withdraw.", "Enemy forces have broken into key defensive positions. Delay the advance while neighboring units withdraw.", "Orders have arrived. Summa must be abandoned. Hold long enough for the remaining troops and wounded to escape.")
weathers = PackedStringArray("Weather: Light Snowfall", "Weather: Heavy Snowfall\nVisibility: Poor", "Weather: Clear and Bitterly Cold", "Weather: Clear Skies", "Weather: Snow and Artillery Smoke", "Weather: Overcast", "Weather: Dense Fog\nTemperature: ~−20°C", "Weather: Fog Clearing", "Weather: Low Cloud and Fog\nVisibility: Moderate", "Weather: Dusk")
photos = PackedStringArray("res://assets/photos/sa_kuva_144612.jpg", "res://assets/photos/sa_kuva_117623.jpg", "res://assets/photos/sa_kuva_a_4.jpg", "res://assets/photos/sa_kuva_a_511.jpg", "res://assets/photos/sa_kuva_a_126.jpg", "res://assets/photos/sa_kuva_a_125.jpg", "res://assets/photos/sa_kuva_a_8.jpg", "res://assets/photos/sa_kuva_a_123.jpg", "res://assets/photos/sa_kuva_144607.jpg", "res://assets/photos/sa_kuva_a_129.jpg")
